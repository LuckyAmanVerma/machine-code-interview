  },
  "devDependencies": {
     "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0"
  }
}